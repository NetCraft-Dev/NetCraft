<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>true</IsPackable>
    <PackageId>NetCraft</PackageId>
    <Description>C#/.NET 10 reimplementation of Minecraft 26.2 - main aggregation library</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetCraft.Registry\NetCraft.Registry.csproj">
      <OutputItemType>ReferencePath</OutputItemType>
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\NetCraft.Storage\NetCraft.Storage.csproj">
      <OutputItemType>ReferencePath</OutputItemType>
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\NetCraft.Resources\NetCraft.Resources.csproj">
      <OutputItemType>ReferencePath</OutputItemType>
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\NetCraft.Tags\NetCraft.Tags.csproj">
      <OutputItemType>ReferencePath</OutputItemType>
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\NetCraft.Network\NetCraft.Network.csproj">
      <OutputItemType>ReferencePath</OutputItemType>
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\NetCraft.Commands\NetCraft.Commands.csproj">
      <OutputItemType>ReferencePath</OutputItemType>
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\NetCraft.Primitives\bin\$(Configuration)\net10.0\NetCraft.Primitives.dll">
      <LogicalName>NetCraft.Embedded.NetCraft.Primitives.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\NetCraft.Config\bin\$(Configuration)\net10.0\NetCraft.Config.dll">
      <LogicalName>NetCraft.Embedded.NetCraft.Config.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\NetCraft.Interop\bin\$(Configuration)\net10.0\NetCraft.Interop.dll">
      <LogicalName>NetCraft.Embedded.NetCraft.Interop.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\NetCraft.Nbt\bin\$(Configuration)\net10.0\NetCraft.Nbt.dll">
      <LogicalName>NetCraft.Embedded.NetCraft.Nbt.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\NetCraft.Util\bin\$(Configuration)\net10.0\NetCraft.Util.dll">
      <LogicalName>NetCraft.Embedded.NetCraft.Util.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\NetCraft.Registry\bin\$(Configuration)\net10.0\NetCraft.Registry.dll">
      <LogicalName>NetCraft.Embedded.NetCraft.Registry.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\NetCraft.Storage\bin\$(Configuration)\net10.0\NetCraft.Storage.dll">
      <LogicalName>NetCraft.Embedded.NetCraft.Storage.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\NetCraft.Resources\bin\$(Configuration)\net10.0\NetCraft.Resources.dll">
      <LogicalName>NetCraft.Embedded.NetCraft.Resources.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\NetCraft.Tags\bin\$(Configuration)\net10.0\NetCraft.Tags.dll">
      <LogicalName>NetCraft.Embedded.NetCraft.Tags.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\NetCraft.Network\bin\$(Configuration)\net10.0\NetCraft.Network.dll">
      <LogicalName>NetCraft.Embedded.NetCraft.Network.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\NetCraft.Commands\bin\$(Configuration)\net10.0\NetCraft.Commands.dll">
      <LogicalName>NetCraft.Embedded.NetCraft.Commands.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Lang\*.json" LogicalName="assets/netcraft/lang/%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="CleanRedundantSubLibraries" AfterTargets="Build">
    <ItemGroup>
      <RedundantSubLibraries Include="$(OutputPath)NetCraft.*.dll" Exclude="$(OutputPath)NetCraft.dll" />
    </ItemGroup>
    <Delete Files="@(RedundantSubLibraries)" />
    <Message Text="[CleanRedundantSubLibraries] Removed redundant sub-library dlls: %(RedundantSubLibraries.Filename)" Importance="high" />
  </Target>

</Project>
