<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gui="using:NetCraft.Server.Gui"
             x:Class="NetCraft.Server.Gui.ServerJitPanel">

  <Grid RowDefinitions="Auto,10,*,6,Auto">
    <TextBlock Classes="cardTitle" Text="JIT COMPILATION" />

    <!--用 ListBox 而不是 ItemsControl 它自带虚拟化 状态表涨到几万条也只渲染看得见的那几行-->
    <!--容器备好时给新行播一次入场动画 具体判定在 OnRowPrepared 里-->
    <ListBox x:Name="Rows" Grid.Row="2" Classes="plain" ContainerPrepared="OnRowPrepared">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="gui:JitRow">
          <Border Classes="listRowBox">
            <Grid ColumnDefinitions="82,*">
              <!--升层时状态文案会换 配色由过渡平滑过去而不是硬切-->
              <TextBlock Text="{Binding Status}" Foreground="{Binding Brush}"
                         FontFamily="{DynamicResource MonoFont}" FontSize="11.5"
                         FontWeight="SemiBold">
                <TextBlock.Transitions>
                  <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.25" />
                  </Transitions>
                </TextBlock.Transitions>
              </TextBlock>
              <TextBlock Grid.Column="1" Classes="listRow"
                         FontFamily="{DynamicResource MonoFont}"
                         Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock x:Name="Summary" Grid.Row="4" Classes="metricLabel" />
  </Grid>

</UserControl>
