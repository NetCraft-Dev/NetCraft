<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    NetCraft.TPGA 第三方正版验证服务器 (Third-party Genuine Authentication Server)
    独立 ASP.NET Core 应用 不引用任何 NetCraft.* 项目
    双端口 主端口 Yggdrasil 验证 API api端口 wss + 管理后台
    TargetFramework/LangVersion/Nullable/ImplicitUsings 由上层 Directory.Build.props 提供
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>NetCraft.TPGA</AssemblyName>
    <RootNamespace>NetCraft.TPGA</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AspNet.Security.OAuth.GitHub" Version="10.0.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="i18n\locales\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!--webui 前端翻译文件 复制到输出目录供 I18nEndpoints 运行时读取-->
    <None Include="i18n\webui\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--webui 构建产物内嵌为资源 由 EmbeddedFileProvider 提供服务
      Web SDK 默认把 wwwroot 当 Content 处理 这里改为 EmbeddedResource 避免冲突-->
  <ItemGroup>
    <Content Remove="wwwroot\**\*" />
    <EmbeddedResource Include="wwwroot\**\*" />
  </ItemGroup>

</Project>
